# Copy to .env and fill in real values. .env is gitignored and must NEVER be committed.

# ---- PostgreSQL ----
POSTGRES_DB=enterprise_management
POSTGRES_USER=ems_user
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_PORT=5433

# ---- API ----
# Consumed by the API. In Docker Compose the host is the service name (db), not localhost.
ConnectionStrings__DefaultConnection="Host=localhost;Port=5433;Database=enterprise_management;Username=ems_user;Password=change_me_to_a_strong_password"

# ---- JWT ----
# Must be at least 32 bytes for HMAC-SHA256. Generate with:
#   head -c 48 /dev/urandom | base64
Jwt__Key=generate_a_long_random_base64_secret
Jwt__Issuer=EnterpriseManagement.Api
Jwt__Audience=EnterpriseManagement.Client
Jwt__ExpiryMinutes=60

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:5080/api

# Bootstrap admin, created at startup if set. Change in any real deployment.
Seed__AdminEmail=admin@example.com
Seed__AdminPassword=change_me_to_a_strong_password
